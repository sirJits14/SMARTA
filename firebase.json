{
  "hosting": [
    {
      "target": "sims",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**", "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" }
        ] },
        { "source": "/assets/**", "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ] }
      ]
    },
    {
      "target": "parent",
      "public": "parent/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**", "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), camera=(self), microphone=()" }
        ] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
        { "source": "/firebase-messaging-sw.js", "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ] },
        { "source": "/assets/**", "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ] }
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22", "predeploy": ["node scripts/syncShared.mjs"] }],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "pubsub": { "port": 8085 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": false
  }
}
