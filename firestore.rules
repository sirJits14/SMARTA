rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /students/{id}            { allow read, write: if signedIn(); }
    match /sections/{id}            { allow read, write: if signedIn(); }
    match /schedules/{id}           { allow read, write: if signedIn(); }
    match /enrollments/{id}         { allow read, write: if signedIn(); }
    match /student_attendance/{id}  { allow read, write: if signedIn(); }
    match /settings/{id}            { allow read, write: if signedIn(); }
    match /users/{id}               { allow read: if signedIn(); allow write: if signedIn(); }
  }
}
