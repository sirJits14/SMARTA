{
  "hosting": [
    {
      "target": "parent",
      "public": ".superpowers/releases/parent-rel/parent/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**", "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), camera=(self), microphone=()" }
        ] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
        { "source": "/firebase-messaging-sw.js", "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ] },
        { "source": "/assets/**", "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ] }
      ]
    }
  ]
}
