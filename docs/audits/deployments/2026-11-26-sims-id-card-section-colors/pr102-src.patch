+    const colors = sectionColorMap(sections.map((s, i) => entry(s, `l${i}`)));
+    for (let i = 1; i < sections.length; i += 1) {
+      expect(colors.get(sections[i].id)).not.toBe(colors.get(sections[i - 1].id));
+    }
