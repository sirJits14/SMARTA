# Copy to scripts/.env.migration and fill in real values. This file is
# gitignored — never commit it. Used once, by a human, to run
# migrate-teachers-from-attendance.mjs.

# bnhs-attendance's real Firebase web-app config (source — read-only, teachers
# collection there has `allow read: if true`, no auth needed to read it).
SOURCE_FIREBASE_API_KEY=
SOURCE_FIREBASE_AUTH_DOMAIN=
SOURCE_FIREBASE_PROJECT_ID=
SOURCE_FIREBASE_STORAGE_BUCKET=
SOURCE_FIREBASE_MESSAGING_SENDER_ID=
SOURCE_FIREBASE_APP_ID=

# bnhs-sims's real Firebase web-app config (target — same values already in
# this project's own .env).
TARGET_FIREBASE_API_KEY=
TARGET_FIREBASE_AUTH_DOMAIN=
TARGET_FIREBASE_PROJECT_ID=
TARGET_FIREBASE_STORAGE_BUCKET=
TARGET_FIREBASE_MESSAGING_SENDER_ID=
TARGET_FIREBASE_APP_ID=

# A real bnhs-sims registrar login (Email/Password auth) — the script signs
# in as this user because bnhs-sims's `teachers` collection requires
# `signedIn()` to write.
TARGET_USER_EMAIL=
TARGET_USER_PASSWORD=
